//rijoles
{
  "title": "Fríjoles Colombianos Tradicionales",
  "shortDescription": "Preparación tradicional colombiana elaborada con fríjol rojo cocido lentamente junto con manita de cerdo, plátano macho y zanahoria. Su característica textura espesa y cremosa se logra al triturar parte de los vegetales de la cocción y reincorporarlos a la olla. De sabor profundo y reconfortante, es base de la bandeja paisa y suele acompañarse con arroz, aguacate y cilantro fresco. Rico en fibra y proteína; personas con hipertensión deben moderar la sal y quienes sigan dietas bajas en grasa pueden optar por reducir el contenido cárnico.",
  "servings": 6,
  "difficultyId": 2,
  "licenseName": "Directo al Paladar",
  "licenseUrl": "https://www.directoalpaladar.com/recetas-de-legumbres/frijoles-colombianos-cremoso-plato-cuchara-tradicional-muy-facil-repleto-sabor",
  "categoryIds": [2],
  "flavorIds": [1],
  "ingredients": [
    { "ingredientId": "Fríjol rojo", "quantity": 600, "unitId": 9 },
    { "ingredientId": "Manita de cerdo", "quantity": 1, "unitId": 10 },
    { "ingredientId": "Plátano macho", "quantity": 1, "unitId": 10 },
    { "ingredientId": "Zanahoria", "quantity": 4, "unitId": 10 },
    { "ingredientId": "Tomates maduros", "quantity": 3, "unitId": 10 },
    { "ingredientId": "Cebolla", "quantity": 1, "unitId": 10 },
    { "ingredientId": "Diente de Ajo", "quantity": 1, "unitId": 10 },
    { "ingredientId": "Comino molido", "quantity": 1, "unitId": 3 },
    { "ingredientId": "Cilantro", "quantity": 1, "unitId": 11 },
    { "ingredientId": "Aceite de oliva", "quantity": 45, "unitId": 1 },
    { "ingredientId": "Sal", "quantity": 1, "unitId": 11 },
    { "ingredientId": "Pimienta negra", "quantity": 1, "unitId": 11 },
    { "ingredientId": "Agua", "quantity": 3, "unitId": 2 }
  ],
  "images": [],
  "steps": [
    {
      "stepOrder": 1,
      "description": "Lavar y seleccionar los fríjoles. Remojarlos en abundante agua durante mínimo 8 horas para mejorar su cocción y digestión.",
      "timeSeconds": 28800,
      "imageUrl": null
    },
    {
      "stepOrder": 2,
      "description": "Escurrir los fríjoles y colocarlos en una olla a presión (también se puede relizar el procedimiento en una olla convencional pero en dicho caso se necesitará más tiempo de cocción) junto con la manita de cerdo. Cubrir con agua suficiente (3 a 4 dedos por encima del nivel de los fríjoles).",
      "timeSeconds": 300,
      "imageUrl": null
    },
    {
      "stepOrder": 3,
      "description": "Llevar a ebullición, retirar las impurezas si aparecen. Mientras tanto preparar el hogao: sofreír el ajo picado en el aceite, agregar la cebolla picada y una pizca de sal. Cuando la cebolla esté tierna agregamos el comino y el tomate rallado. Pochar 15 minutos o hasta que no queden restos de agua. Luego de esto hechar pimienta al gusto y reservar",
      "timeSeconds": 900,
      "imageUrl": null
    },
    {
      "stepOrder": 4,
      "description": "Luego de preparar el hogao y tener la olla con los frijoles limpia de impurezas se agrega la zanahoria y el plátano macho, ambos pelados y en trozos. También se agregan cuatro cucharadas de hogao. Cerrar la olla a presión y cocinar durante 20 a 25 minutos desde que comience a salir vapor constante (en olla convencional puede tardar hasta dos horas y media).",
      "timeSeconds": 1500,
      "imageUrl": null
    },
    {
      "stepOrder": 5,
      "description": "Abrir la olla una vez despresurizada. Se retira la manita de cerdoy se reserva si se quiere añadir a los frijoles a la hora de servirlos. Retirar el plátano y la zanahoria, triturarlos con un poco del caldo y devolver el puré a la olla para lograr la textura espesa característica.",
      "timeSeconds": 600,
      "imageUrl": null
    },
    {
      "stepOrder": 6,
      "description": "Cocinar 5 a 10 minutos adicionales para integrar sabores.",
      "timeSeconds": 300,
      "imageUrl": null
    },
    {
      "stepOrder": 7,
      "description": "Rectificar la sal, añadir cilantro fresco picado al gusto y servir caliente acompañado de arroz, aguacate o patacones.",
      "timeSeconds": 180,
      "imageUrl": null
    }
  ]
}
